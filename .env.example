# Google APIs (optional - fallback to JSON si no están configuradas)
GOOGLE_DRIVE_API_KEY=
GOOGLE_PLACES_API_KEY=

# Content API URL (usado en build-time)
# En desarrollo local con Functions: http://localhost:8788/api/public/content
# En producción Pages: https://tu-dominio.pages.dev/api/public/content
PUBLIC_CONTENT_API_URL=http://localhost:8788/api/public/content

# Cloudflare Pages Deploy Hook (usado por /api/publish)
# Crear en Cloudflare Pages → Settings → Builds & deployments → Build hooks
CF_PAGES_DEPLOY_HOOK_URL=

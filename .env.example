# Cloudflare Configuration
# Required for migrate-drive-to-r2.ts script

# Cloudflare Account ID (encontrar en Cloudflare Dashboard → Account ID)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Cloudflare API Token con permisos: R2 Read + R2 Write
# Crear en: Cloudflare Dashboard → My Profile → API Tokens → Create Token
CLOUDFLARE_API_TOKEN=your_api_token_here

# R2 Bucket Name (debe coincidir con el creado con wrangler)
R2_BUCKET_NAME=don-franco-media

# Google Drive API Key (opcional — solo requerido para descargar assets desde Drive)
# Crear en: Google Cloud Console → APIs & Services → Credentials → Create API Key
# Habilitar: Google Drive API
GOOGLE_DRIVE_API_KEY=your_drive_api_key_here

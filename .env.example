# Don Franco Admin Panel - Variables de entorno requeridas

# ============================================================
# FASE 1: Infraestructura base
# ============================================================

# Cloudflare Account ID (encontrar en Cloudflare Dashboard → Account ID)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Cloudflare API Token con permisos: R2 Read + R2 Write
# Crear en: Cloudflare Dashboard → My Profile → API Tokens → Create Token
CLOUDFLARE_API_TOKEN=your_api_token_here

# R2 Bucket Name (debe coincidir con el creado con wrangler)
R2_BUCKET_NAME=don-franco-media

# Google Drive API Key (opcional — solo requerido para descargar assets desde Drive)
# Crear en: Google Cloud Console → APIs & Services → Credentials → Create API Key
# Habilitar: Google Drive API
GOOGLE_DRIVE_API_KEY=your_drive_api_key_here

# ============================================================
# FASE 2: Admin API & Cloudflare Access
# ============================================================

# Cloudflare Access configuración (REQUERIDO en producción)
# Obtener de: Cloudflare Dashboard > Zero Trust > Access > Applications
ACCESS_AUD=your-access-audience-tag-here
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com

# Dev bypass (SOLO para desarrollo local - NO usar en producción)
ENVIRONMENT=development
ADMIN_DEV_BYPASS_SECRET=your-secret-key-here

# Cloudflare Pages Deploy Hook (para botón "Publicar")
# Obtener de: Cloudflare Dashboard > Pages > Settings > Builds & Deployments > Deploy Hooks
CF_PAGES_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/your-hook-id

---
import siteData from '../content/site.json';

const { rating, reviewCount, mapsUrl } = siteData.reviews;
const stars = Math.round(rating);
---

<section class="trust-strip">
  <div class="container">
    <div class="trust-content">
      <div class="trust-rating">
        <div class="trust-stars">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg 
              width="20" 
              height="20" 
              viewBox="0 0 24 24" 
              fill={i < stars ? 'currentColor' : 'none'}
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          ))}
        </div>
        <span class="trust-score">{rating.toFixed(1)}</span>
      </div>
      
      <div class="trust-divider"></div>
      
      <div class="trust-reviews">
        <span class="trust-count">~{reviewCount}</span>
        <span class="trust-label">reseñas</span>
      </div>
      
      <div class="trust-divider"></div>
      
      <a 
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="trust-link"
      >
        Ver en Google Maps
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .trust-strip {
    background: var(--color-text);
    border-bottom: 1px solid rgba(26, 22, 20, 0.1);
    padding: var(--space-6) 0;
  }

  .trust-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    width: 100%;
  }

  .trust-rating {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    flex-wrap: wrap;
  }

  .trust-stars {
    display: flex;
    gap: var(--space-1);
    color: var(--color-accent-2);
  }

  .trust-score {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-bg);
  }

  .trust-divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
    display: none;
  }

  .trust-reviews {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .trust-count {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-bg);
    line-height: 1;
  }

  .trust-label {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .trust-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    transition: color var(--transition-fast);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    min-width: 0;
    white-space: normal;
    text-align: center;
  }

  @media (min-width: 768px) {
    .trust-link {
      white-space: nowrap;
    }
  }

  .trust-link:hover {
    color: var(--color-accent-2);
    background: var(--color-surface-2);
  }

  @media (min-width: 768px) {
    .trust-divider {
      display: block;
    }
  }
</style>

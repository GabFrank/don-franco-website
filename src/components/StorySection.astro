---
import siteData from '../content/site.json';

const { title, paragraphs } = siteData.story;

const proofChips = [
  { 
    text: '2018 · Primera cerveza artesanal de la región',
    icon: 'beer'
  },
  { 
    text: '2020 · Restaurante',
    icon: 'restaurant'
  },
  { 
    text: 'Hecho en Salto del Guairá',
    icon: 'location'
  }
];
---

<section id="historia" class="section section-light">
  <div class="container">
    <h2 class="section-title">Nuestra Historia</h2>
    
    <div class="story-chips">
      {proofChips.map(chip => (
        <div class="story-chip">
          {chip.icon === 'beer' && (
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M17 11h1a3 3 0 010 6h-1m-4-6v6m-4-6v6M5 11h11a2 2 0 012 2v6c0 1.1-.9 2-2 2H5a2 2 0 01-2-2v-6c0-1.1.9-2 2-2zM7 11V7a5 5 0 0110 0v4"/>
            </svg>
          )}
          {chip.icon === 'restaurant' && (
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12 2v20m-4-4h8m-8-4h8M8 6V4m8 2V4"/>
            </svg>
          )}
          {chip.icon === 'location' && (
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          )}
          <span class="chip-text">{chip.text}</span>
        </div>
      ))}
    </div>

    <div class="story-content">
      {paragraphs.map((paragraph: string) => (
        <p class="story-paragraph">{paragraph}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .story-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-bottom: var(--space-10);
    width: 100%;
  }

  .story-chip {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-craft);
    color: var(--color-text);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    min-width: 0;
  }

  .story-chip svg {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .chip-text {
    white-space: normal;
    line-height: 1.3;
  }

  .story-content {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .story-paragraph {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: #5A5046;
    text-align: center;
  }

  @media (min-width: 768px) {
    .story-paragraph {
      font-size: var(--text-xl);
    }

    .story-chip {
      font-size: var(--text-base);
    }
  }
</style>

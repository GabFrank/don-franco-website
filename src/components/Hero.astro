---
import siteData from '../content/site.json';
import { getMenuPageImageUrl } from '../lib/drive';

const { title, tagline, description, ctaText, backgroundImages } = siteData.hero;
const { whatsapp } = siteData.contact;

// Convert Drive share links to direct image URLs
const heroImage = backgroundImages && backgroundImages[0] 
  ? getMenuPageImageUrl({ url: backgroundImages[0] })
  : '';
---

<section class="hero">
  {heroImage && (
    <div class="hero-background">
      <img src={heroImage} alt="Don Franco" loading="eager" />
      <div class="hero-overlay"></div>
    </div>
  )}
  
  <div class="hero-content">
    <div class="hero-text">
      <h1 class="hero-title">{title}</h1>
      <p class="hero-tagline">{tagline}</p>
      <p class="hero-description">{description}</p>
      
      <div class="hero-ctas">
        <a 
          href={`https://wa.me/${whatsapp}?text=${encodeURIComponent('Hola! Me gustaría hacer una reserva')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Reservar WhatsApp
        </a>
        <a href="#menu" class="btn btn-secondary">
          {ctaText}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.5);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(232, 93, 4, 0.15) 0%,
      rgba(26, 22, 20, 0.6) 50%,
      rgba(26, 22, 20, 0.8) 100%
    );
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(232, 93, 4, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(240, 162, 2, 0.06) 0%, transparent 50%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-8) var(--container-padding);
    text-align: center;
  }

  .hero-text {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text);
    margin-bottom: var(--space-4);
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.7);
  }

  .hero-tagline {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: var(--space-6);
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 479px) {
    .hero-title {
      letter-spacing: 0.05em;
    }

    .hero-tagline {
      letter-spacing: 0.1em;
    }
  }

  @media (max-width: 359px) {
    .hero-title {
      font-size: clamp(2rem, 8vw, 3rem);
      letter-spacing: 0.03em;
    }

    .hero-tagline {
      font-size: var(--text-lg);
      letter-spacing: 0.08em;
    }
  }

  .hero-description {
    font-size: var(--text-xl);
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: var(--space-8);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
    width: 100%;
  }

  @media (min-width: 768px) {
    .hero-ctas {
      flex-direction: row;
      justify-content: center;
    }
  }
</style>

---
import siteData from '../content/site.json';
import menuPagesData from '../content/menu-pages.json';
import menuDigitalData from '../content/menu-digital.json';
import { getMenuPageImageUrl } from '../lib/drive';

const menuConfig = siteData.menu;
const mode = menuConfig.mode;

const showPng = mode === 'png' || mode === 'both';
const showDigital = mode === 'digital' || mode === 'both';

let menuPages: Array<{ url: string; alt: string }> = [];
let firstPagePreview = '';
if (showPng && menuPagesData.pages) {
  menuPages = menuPagesData.pages.map((page: any) => ({
    url: getMenuPageImageUrl(page),
    alt: page.alt || 'Página de menú'
  }));
  firstPagePreview = menuPages[0]?.url || '';
}

const categories = showDigital ? menuDigitalData.categories : [];

// Get spotlight items from menu-digital (first 3 items from first category with items)
const spotlightCategory = menuDigitalData.categories.find((cat: any) => cat.items && cat.items.length > 0);
const spotlightItems = spotlightCategory ? spotlightCategory.items.slice(0, 3) : [];
---

<section id="menu" class="section section-light">
  <div class="container">
    <h2 class="section-title">Nuestro Menú</h2>

    {mode === 'both' && (
      <div class="menu-tabs">
        <button class="menu-tab active" data-tab="png">Menú Visual</button>
        <button class="menu-tab" data-tab="digital">Menú Digital</button>
      </div>
    )}

    {showPng && (
      <div class="menu-png" data-content="png" style={mode === 'both' ? '' : 'display: block'}>
        {firstPagePreview && (
          <div class="menu-preview-card">
            <img src={firstPagePreview} alt="Menú Don Franco" class="menu-preview-image" />
            <div class="menu-preview-overlay">
              <button class="btn btn-primary" id="open-menu-fullscreen">
                Ver Menú Completo
              </button>
            </div>
          </div>
        )}
        {!firstPagePreview && (
          <div class="menu-cta-fallback">
            <p class="menu-intro">Explora nuestro menú completo</p>
            <button class="btn btn-primary" id="open-menu-fullscreen">Ver Menú Completo</button>
          </div>
        )}
      </div>
    )}

    {showDigital && (
      <div class="menu-digital" data-content="digital" style={mode === 'digital' ? 'display: block' : mode === 'both' ? 'display: none' : 'display: block'}>
        {categories.map((category: any) => (
          <div class="menu-category">
            <h3 class="category-name">{category.name}</h3>
            {category.description && (
              <p class="category-description">{category.description}</p>
            )}
            
            <div class="menu-items">
              {category.items.map((item: any) => (
                <div class="menu-item">
                  <div class="menu-item-header">
                    <div>
                      <h4 class="item-name">{item.name}</h4>
                      {item.badge && (
                        <span class="badge">{item.badge}</span>
                      )}
                    </div>
                    <span class="item-price">
                      {item.currency} {item.price.toLocaleString('es-PY')}
                    </span>
                  </div>
                  {item.description && (
                    <p class="item-description">{item.description}</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    {mode === 'png' && spotlightItems.length > 0 && (
      <div class="menu-spotlight">
        <h3 class="spotlight-title">Clásicos de la Casa</h3>
        <div class="spotlight-items">
          {spotlightItems.map((item: any) => (
            <div class="spotlight-item">
              <h4 class="spotlight-item-name">{item.name}</h4>
              <p class="spotlight-item-description">{item.description}</p>
              <span class="spotlight-item-price">
                {item.currency} {item.price.toLocaleString('es-PY')}
              </span>
            </div>
          ))}
        </div>
      </div>
    )}
    
    <p class="menu-disclaimer">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 16v-4m0-4h.01"/>
      </svg>
      Consultá por WhatsApp alergias o preferencias
    </p>
  </div>
</section>

<style>
  .menu-intro {
    text-align: center;
    font-size: var(--text-lg);
    color: #5A5046;
    margin-bottom: var(--space-6);
  }

  .menu-cta-fallback {
    text-align: center;
    padding: var(--space-8);
  }

  .menu-preview-card {
    position: relative;
    max-width: 600px;
    margin: 0 auto var(--space-8);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    cursor: pointer;
  }

  .menu-preview-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .menu-preview-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26, 22, 20, 0.95) 0%, rgba(26, 22, 20, 0.8) 50%, transparent 100%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--space-6);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .menu-preview-card:hover .menu-preview-overlay {
    opacity: 1;
  }

  .menu-preview-overlay .btn {
    background: var(--color-accent);
    color: var(--color-text);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    box-shadow: var(--shadow-lg);
  }

  .menu-spotlight {
    margin-top: var(--space-12);
    padding-top: var(--space-12);
    border-top: 2px solid var(--color-border);
  }

  .spotlight-title {
    font-size: var(--text-2xl);
    color: var(--color-accent);
    text-align: center;
    margin-bottom: var(--space-8);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .spotlight-items {
    display: grid;
    gap: var(--space-6);
    max-width: 900px;
    margin: 0 auto;
  }

  .spotlight-item {
    background: white;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .spotlight-item-name {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-bg);
    margin-bottom: var(--space-2);
  }

  .spotlight-item-description {
    font-size: var(--text-base);
    color: #5A5046;
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .spotlight-item-price {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-accent);
  }

  .menu-disclaimer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding: var(--space-4);
    font-size: var(--text-sm);
    color: #5A5046;
    background: rgba(61, 90, 69, 0.1);
    border-radius: var(--radius-md);
    border: 1px solid rgba(61, 90, 69, 0.2);
  }

  .menu-disclaimer svg {
    flex-shrink: 0;
    color: var(--color-craft);
  }

  .menu-tabs {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .menu-tab {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-md);
    background: white;
    color: var(--color-bg);
    border: 2px solid var(--color-border);
    transition: all var(--transition-base);
    min-height: var(--touch-target);
  }

  .menu-tab.active {
    background: var(--color-accent);
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .menu-digital {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .menu-category {
    background: white;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
  }

  .category-name {
    font-size: var(--text-2xl);
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .category-description {
    font-size: var(--text-base);
    color: #5A5046;
    margin-bottom: var(--space-6);
  }

  .menu-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .menu-item {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .menu-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .menu-item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .item-name {
    font-size: var(--text-lg);
    color: var(--color-bg);
    margin-bottom: var(--space-1);
  }

  .item-price {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-accent-2);
    white-space: nowrap;
  }

  .item-description {
    font-size: var(--text-sm);
    color: #5A5046;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .menu-category {
      padding: var(--space-8);
    }

    .menu-items {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
      gap: var(--space-8);
    }

    .spotlight-items {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }
</style>

{showPng && (
  <script>
    import menuPagesData from '../content/menu-pages.json';
    import { getMenuPageImageUrl } from '../lib/drive';
    
    const openBtn = document.getElementById('open-menu-fullscreen');
    const previewCard = document.querySelector('.menu-preview-card');
    const menuPages = menuPagesData.pages.map((page: any) => ({
      url: getMenuPageImageUrl(page),
      alt: page.alt || 'Página de menú'
    }));

    const openMenu = () => {
      const event = new CustomEvent('open-menu-fullscreen', { 
        detail: { pages: menuPages } 
      });
      window.dispatchEvent(event);
    };

    openBtn?.addEventListener('click', openMenu);
    previewCard?.addEventListener('click', openMenu);
  </script>
)}

<script>
  const tabs = document.querySelectorAll('.menu-tab');
  const pngContent = document.querySelector('[data-content="png"]') as HTMLElement;
  const digitalContent = document.querySelector('[data-content="digital"]') as HTMLElement;

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.tab;
      
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      if (target === 'png' && pngContent) {
        pngContent.style.display = 'block';
        if (digitalContent) digitalContent.style.display = 'none';
      } else if (target === 'digital' && digitalContent) {
        digitalContent.style.display = 'block';
        if (pngContent) pngContent.style.display = 'none';
      }
    });
  });
</script>

---
import siteData from '../content/site.json';
import menuPagesData from '../content/menu-pages.json';
import menuDigitalData from '../content/menu-digital.json';
import { getMenuPageImageUrl } from '../lib/drive';

const menuConfig = siteData.menu;
const mode = menuConfig.mode;

const showPng = mode === 'png' || mode === 'both';
const showDigital = mode === 'digital' || mode === 'both';

let menuPages: Array<{ url: string; alt: string }> = [];
if (showPng && menuPagesData.pages) {
  menuPages = menuPagesData.pages.map((page: any) => ({
    url: getMenuPageImageUrl(page),
    alt: page.alt || 'Página de menú'
  }));
}

const categories = showDigital ? menuDigitalData.categories : [];
---

<section id="menu" class="section">
  <div class="container">
    <h2 class="section-title">Nuestro Menú</h2>

    {mode === 'both' && (
      <div class="menu-tabs">
        <button class="menu-tab active" data-tab="png">Menú Visual</button>
        <button class="menu-tab" data-tab="digital">Menú Digital</button>
      </div>
    )}

    {showPng && (
      <div class="menu-png" data-content="png" style={mode === 'both' ? '' : 'display: block'}>
        <p class="menu-intro">Explora nuestro menú completo</p>
        <button class="btn btn-primary" id="open-menu-fullscreen">Ver Menú Completo</button>
      </div>
    )}

    {showDigital && (
      <div class="menu-digital" data-content="digital" style={mode === 'digital' ? 'display: block' : mode === 'both' ? 'display: none' : 'display: block'}>
        {categories.map((category: any) => (
          <div class="menu-category">
            <h3 class="category-name">{category.name}</h3>
            {category.description && (
              <p class="category-description">{category.description}</p>
            )}
            
            <div class="menu-items">
              {category.items.map((item: any) => (
                <div class="menu-item">
                  <div class="menu-item-header">
                    <div>
                      <h4 class="item-name">{item.name}</h4>
                      {item.badge && (
                        <span class="badge">{item.badge}</span>
                      )}
                    </div>
                    <span class="item-price">
                      {item.currency} {item.price.toLocaleString('es-PY')}
                    </span>
                  </div>
                  {item.description && (
                    <p class="item-description">{item.description}</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .menu-intro {
    text-align: center;
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }

  .menu-png {
    text-align: center;
  }

  .menu-tabs {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .menu-tab {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-muted);
    border: 2px solid var(--color-border);
    transition: all var(--transition-base);
    min-height: var(--touch-target);
  }

  .menu-tab.active {
    background: var(--color-accent);
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .menu-digital {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .menu-category {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
  }

  .category-name {
    font-size: var(--text-2xl);
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .category-description {
    font-size: var(--text-base);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }

  .menu-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .menu-item {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .menu-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .menu-item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .item-name {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .item-price {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-accent-2);
    white-space: nowrap;
  }

  .item-description {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .menu-category {
      padding: var(--space-8);
    }

    .menu-items {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
      gap: var(--space-8);
    }
  }
</style>

{showPng && (
  <script>
    import menuPagesData from '../content/menu-pages.json';
    import { getMenuPageImageUrl } from '../lib/drive';
    
    const openBtn = document.getElementById('open-menu-fullscreen');
    const menuPages = menuPagesData.pages.map((page: any) => ({
      url: getMenuPageImageUrl(page),
      alt: page.alt || 'Página de menú'
    }));

    openBtn?.addEventListener('click', () => {
      const event = new CustomEvent('open-menu-fullscreen', { 
        detail: { pages: menuPages } 
      });
      window.dispatchEvent(event);
    });
  </script>
)}

<script>
  const tabs = document.querySelectorAll('.menu-tab');
  const pngContent = document.querySelector('[data-content="png"]') as HTMLElement;
  const digitalContent = document.querySelector('[data-content="digital"]') as HTMLElement;

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.tab;
      
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      if (target === 'png' && pngContent) {
        pngContent.style.display = 'block';
        if (digitalContent) digitalContent.style.display = 'none';
      } else if (target === 'digital' && digitalContent) {
        digitalContent.style.display = 'block';
        if (pngContent) pngContent.style.display = 'none';
      }
    });
  });
</script>

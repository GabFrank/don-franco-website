---
import siteData from '../content/site.json';

const { tagline, mapsUrl, instagramUrl, facebookUrl, legalText } = siteData.footer;
const { address, phone, hours } = siteData.contact;
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <img src="/logo.png" alt="Don Franco" class="footer-logo" />
        <p class="footer-tagline">{tagline}</p>
      </div>

      <div class="footer-info">
        <h4 class="footer-heading">Visitanos</h4>
        <div class="footer-info-items">
          <div class="footer-info-item">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{address}</span>
          </div>
          <div class="footer-info-item">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            <span>{hours}</span>
          </div>
          <div class="footer-info-item">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>
          </div>
        </div>
      </div>

      <div class="footer-links">
        <h4 class="footer-heading">Navegación</h4>
        <nav class="footer-nav">
          <a href="#historia" class="footer-link">Historia</a>
          <a href="#menu" class="footer-link">Menú</a>
          <a href="#galeria" class="footer-link">Galería</a>
          <a href="#contacto" class="footer-link">Contacto</a>
        </nav>
      </div>

      <div class="footer-social">
        <h4 class="footer-heading">Síguenos</h4>
        <div class="social-links">
          {mapsUrl && (
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Google Maps">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </a>
          )}
          {instagramUrl && (
            <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {facebookUrl && (
            <a href={facebookUrl} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Facebook">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-legal">
        © {currentYear} Don Franco. {legalText}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-16) 0 var(--space-8);
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    width: 100%;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .footer-logo {
    display: block;
    height: 56px;
    width: auto;
    object-fit: contain;
  }

  .footer-tagline {
    font-size: var(--text-base);
    color: var(--color-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .footer-info-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .footer-info-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .footer-info-item svg {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .footer-info-item a {
    color: var(--color-muted);
    transition: color var(--transition-fast);
  }

  .footer-info-item a:hover {
    color: var(--color-accent);
  }

  .footer-heading {
    font-size: var(--text-base);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    font-size: var(--text-base);
    color: var(--color-muted);
    transition: color var(--transition-fast);
    padding: var(--space-1) 0;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .social-links {
    display: flex;
    gap: var(--space-4);
  }

  .social-link {
    width: var(--touch-target);
    height: var(--touch-target);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-2);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    transition: all var(--transition-base);
  }

  .social-link:hover {
    background: var(--color-accent);
    color: var(--color-text);
    transform: translateY(-2px);
  }

  .footer-bottom {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .footer-legal {
    font-size: var(--text-sm);
    color: var(--color-muted);
    overflow-wrap: break-word;
    word-break: normal;
    padding: 0 var(--space-4);
  }

  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: 2fr 1.5fr 1fr 1fr;
    }
  }
</style>

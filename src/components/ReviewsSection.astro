---
import { fetchPublicContent } from '../lib/content-api';
import { fetchPlaceRating } from '../lib/places';

const content = await fetchPublicContent();

const title = 'Lo que dicen';
const placeId = content.settings.placeId || '';
const linkText = 'Ver en Google Maps';
const mapsUrl = 'https://maps.app.goo.gl/AcTKAKwEb1h9hc4K9';

// Start with D1 values
let rating = content.reviews.stats?.rating || 4.8;
let reviewCount = content.reviews.stats?.review_count || 120;
const blockVisible = content.reviews.stats?.block_visible || 1;

// Override with live Google data if available
const apiKey = import.meta.env.GOOGLE_PLACES_API_KEY;
if (placeId && apiKey) {
  const placeData = await fetchPlaceRating(apiKey, placeId);
  if (placeData.rating) rating = placeData.rating;
  if (placeData.user_ratings_total) reviewCount = placeData.user_ratings_total;
}

const quotes = content.reviews.quotes.map(q => ({
  text: q.text,
  author: q.author
}));

const stars = Math.round(rating);
const showReviews = blockVisible === 1;
---

{showReviews && (
<section id="reviews" class="section section-dark">
  <div class="container">
    <h2 class="section-title">Lo que dicen</h2>

    <div class="reviews-content">
      <div class="rating-card">
        <div class="rating-value">{rating.toFixed(1)}</div>
        <div class="rating-stars">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg 
              width="24" 
              height="24" 
              viewBox="0 0 24 24" 
              fill={i < stars ? 'currentColor' : 'none'}
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          ))}
        </div>
        <div class="rating-count">{reviewCount} reseñas</div>
        
        <a 
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          {linkText}
        </a>
      </div>

      {quotes && quotes.length > 0 && (
        <div class="review-quotes">
          {quotes.map((quote) => (
            <div class="quote-card">
              <div class="quote-stars">★★★★★</div>
              <p class="quote-text">"{quote.text}"</p>
              <p class="quote-author">— {quote.author}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
)}

<style>
  .reviews-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .reviews-content {
      grid-template-columns: 350px 1fr;
      align-items: start;
    }
  }

  .rating-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: center;
    max-width: 400px;
    width: 100%;
  }

  .rating-value {
    font-size: 4rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: var(--space-4);
  }

  .rating-stars {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    color: var(--color-accent-2);
    margin-bottom: var(--space-3);
  }

  .rating-count {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }

  .review-quotes {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .quote-card {
    background: var(--color-surface);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border-left: 3px solid var(--color-accent);
  }

  .quote-stars {
    color: var(--color-accent-2);
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
    letter-spacing: 0.1em;
  }

  .quote-text {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: var(--space-3);
    font-style: italic;
  }

  .quote-author {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-weight: 600;
  }
</style>

---
import siteData from '../content/site.json';
import { fetchPlaceRating } from '../lib/places';

const { title, placeId, rating: fallbackRating, reviewCount: fallbackReviewCount, linkText, mapsUrl } = siteData.reviews;
const apiKey = import.meta.env.GOOGLE_PLACES_API_KEY;

let rating = fallbackRating;
let reviewCount = fallbackReviewCount;

if (placeId && apiKey) {
  const placeData = await fetchPlaceRating(apiKey, placeId);
  if (placeData.rating) rating = placeData.rating;
  if (placeData.user_ratings_total) reviewCount = placeData.user_ratings_total;
}

const stars = Math.round(rating);
---

<section id="reviews" class="section section-light">
  <div class="container">
    <h2 class="section-title">{title}</h2>

    <div class="reviews-content">
      <div class="rating-card">
        <div class="rating-value">{rating.toFixed(1)}</div>
        <div class="rating-stars">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg 
              width="24" 
              height="24" 
              viewBox="0 0 24 24" 
              fill={i < stars ? 'currentColor' : 'none'}
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          ))}
        </div>
        <div class="rating-count">{reviewCount} reseñas</div>
        
        <a 
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          {linkText}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-content {
    display: flex;
    justify-content: center;
  }

  .rating-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: center;
    max-width: 400px;
    width: 100%;
  }

  .rating-value {
    font-size: 4rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: var(--space-4);
  }

  .rating-stars {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    color: var(--color-accent-2);
    margin-bottom: var(--space-3);
  }

  .rating-count {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }
</style>

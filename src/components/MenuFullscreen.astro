---
// Menu fullscreen component for PNG mode
---

<div class="menu-fullscreen" id="menu-fullscreen">
  <div class="menu-fullscreen-header">
    <button class="menu-fullscreen-close" id="menu-fullscreen-close" aria-label="Cerrar menú">
      <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M24 8L8 24M8 8l16 16"/>
      </svg>
    </button>
  </div>
  
  <div class="menu-fullscreen-content" id="menu-fullscreen-content">
    <div class="menu-pages" id="menu-pages"></div>
  </div>

  <div class="menu-fullscreen-nav">
    <button class="menu-nav-btn" id="menu-prev" aria-label="Anterior">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>
    <span class="menu-page-indicator" id="menu-page-indicator">1 / 1</span>
    <button class="menu-nav-btn" id="menu-next" aria-label="Siguiente">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .menu-fullscreen {
    position: fixed;
    inset: 0;
    background: var(--color-bg);
    z-index: var(--z-modal);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  .menu-fullscreen.active {
    opacity: 1;
    pointer-events: all;
  }

  .menu-fullscreen-header {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .menu-fullscreen-close {
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .menu-fullscreen-close:hover {
    background: var(--color-surface);
    color: var(--color-accent);
  }

  .menu-fullscreen-content {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-4);
  }

  .menu-pages {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .menu-page {
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    cursor: pointer;
    transition: transform var(--transition-base);
  }

  .menu-page:hover {
    transform: scale(1.02);
  }

  .menu-page img {
    width: 100%;
    height: auto;
    display: block;
  }

  .menu-fullscreen-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .menu-nav-btn {
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    background: var(--color-surface);
  }

  .menu-nav-btn:hover:not(:disabled) {
    background: var(--color-accent);
    color: var(--color-text);
  }

  .menu-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .menu-page-indicator {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-muted);
    min-width: 80px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .menu-fullscreen-content {
      padding: var(--space-8);
    }
  }
</style>

<script>
  interface MenuPage {
    url: string;
    alt: string;
  }

  let currentPages: MenuPage[] = [];
  let currentPageIndex = 0;

  const menuFullscreen = document.getElementById('menu-fullscreen');
  const menuClose = document.getElementById('menu-fullscreen-close');
  const menuPagesContainer = document.getElementById('menu-pages');
  const prevBtn = document.getElementById('menu-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('menu-next') as HTMLButtonElement;
  const indicator = document.getElementById('menu-page-indicator');

  function renderPages() {
    if (!menuPagesContainer) return;
    
    menuPagesContainer.innerHTML = currentPages.map((page, index) => `
      <div class="menu-page" data-index="${index}">
        <img src="${page.url}" alt="${page.alt}" loading="lazy" />
      </div>
    `).join('');

    const pageElements = menuPagesContainer.querySelectorAll('.menu-page');
    pageElements.forEach((el, index) => {
      el.addEventListener('click', () => {
        currentPageIndex = index;
        updateNavigation();
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  }

  function updateNavigation() {
    if (indicator) {
      indicator.textContent = `${currentPageIndex + 1} / ${currentPages.length}`;
    }
    
    if (prevBtn) prevBtn.disabled = currentPageIndex === 0;
    if (nextBtn) nextBtn.disabled = currentPageIndex === currentPages.length - 1;
  }

  function scrollToPage(index: number) {
    const page = menuPagesContainer?.querySelector(`[data-index="${index}"]`);
    if (page) {
      page.scrollIntoView({ behavior: 'smooth', block: 'center' });
      currentPageIndex = index;
      updateNavigation();
    }
  }

  function openMenu(pages: MenuPage[]) {
    currentPages = pages;
    currentPageIndex = 0;
    renderPages();
    updateNavigation();
    menuFullscreen?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menuFullscreen?.classList.remove('active');
    document.body.style.overflow = '';
  }

  menuClose?.addEventListener('click', closeMenu);
  
  prevBtn?.addEventListener('click', () => {
    if (currentPageIndex > 0) {
      scrollToPage(currentPageIndex - 1);
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentPageIndex < currentPages.length - 1) {
      scrollToPage(currentPageIndex + 1);
    }
  });

  window.addEventListener('open-menu-fullscreen', ((e: CustomEvent) => {
    openMenu(e.detail.pages);
  }) as EventListener);

  window.addEventListener('keydown', (e) => {
    if (!menuFullscreen?.classList.contains('active')) return;
    
    if (e.key === 'Escape') closeMenu();
    else if (e.key === 'ArrowLeft' && currentPageIndex > 0) scrollToPage(currentPageIndex - 1);
    else if (e.key === 'ArrowRight' && currentPageIndex < currentPages.length - 1) scrollToPage(currentPageIndex + 1);
  });
</script>

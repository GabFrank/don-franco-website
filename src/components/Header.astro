---
import siteData from '../content/site.json';

const navLinks = [
  { href: '#historia', label: 'Historia' },
  { href: '#menu', label: 'Menú' },
  { href: '#galeria', label: 'Galería' },
  { href: '#contacto', label: 'Contacto' }
];

const { whatsapp } = siteData.contact;
---

<header class="header">
  <div class="header-container">
    <a href="/" class="logo">
      <img src="/logo.png" alt="Don Franco" />
    </a>
    
    <nav class="nav desktop-only">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
      <a 
        href={`https://wa.me/${whatsapp}?text=${encodeURIComponent('Hola! Me gustaría hacer una reserva')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary btn-small"
      >
        Reservar
      </a>
    </nav>

    <button class="mobile-menu-btn mobile-only" id="mobile-menu-btn" aria-label="Abrir menú">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M3 12h18M3 6h18M3 18h18"/>
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu-header">
      <img src="/logo.png" alt="Don Franco" />
      <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Cerrar menú">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <nav class="mobile-nav">
      {navLinks.map(link => (
        <a href={link.href} class="mobile-nav-link">{link.label}</a>
      ))}
    </nav>
  </div>
  <div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--color-text);
    border-bottom: 1px solid rgba(26, 22, 20, 0.1);
    max-width: 100%;
  }

  .header-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-2) var(--container-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .logo img {
    display: block;
    height: 48px;
    width: auto;
    max-height: 48px;
    object-fit: contain;
    filter: brightness(0) saturate(100%);
  }

  /* Desktop nav - MUST be hidden on mobile with high specificity */
  .nav,
  .nav.desktop-only {
    gap: var(--space-8);
    display: none !important;
  }

  /* Mobile hamburger - visible by default */
  .mobile-menu-btn,
  .mobile-menu-btn.mobile-only {
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    display: flex !important;
    align-items: center;
    justify-content: center;
    color: var(--color-bg);
  }

  /* Desktop breakpoint */
  @media (min-width: 768px) {
    .nav,
    .nav.desktop-only {
      display: flex !important;
    }

    .mobile-menu-btn,
    .mobile-menu-btn.mobile-only {
      display: none !important;
    }
  }

  .nav-link {
    font-size: var(--text-base);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-bg);
    transition: color var(--transition-fast);
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width var(--transition-base);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Mobile menu - fully off-canvas when closed */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    width: 80%;
    max-width: 320px;
    height: 100vh;
    background: var(--color-surface);
    z-index: var(--z-modal);
    transform: translateX(100%);
    transition: transform var(--transition-base);
    display: flex;
    flex-direction: column;
    visibility: hidden;
    pointer-events: none;
  }

  .mobile-menu.active {
    transform: translateX(0);
    visibility: visible;
    pointer-events: all;
  }

  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.7);
    z-index: calc(var(--z-modal) - 1);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--transition-base), visibility var(--transition-base);
  }

  .mobile-menu-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu-header img {
    display: block;
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .mobile-menu-close {
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-4);
    gap: var(--space-2);
  }

  .mobile-nav-link {
    font-size: var(--text-lg);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .mobile-nav-link:hover {
    background: var(--color-surface-2);
    color: var(--color-accent);
  }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuClose = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-menu-overlay');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    menu?.classList.add('active');
    overlay?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.remove('active');
    overlay?.classList.remove('active');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
  navLinks.forEach(link => link.addEventListener('click', closeMenu));
</script>

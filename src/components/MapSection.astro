---
import siteData from '../content/site.json';

const { title, embedUrl, fallbackLink } = siteData.map;
const { address } = siteData.contact;
---

<section id="mapa" class="section section-compact">
  <div class="container">
    <h2 class="section-title">{title}</h2>
    
    <p class="map-address">{address}</p>

    {embedUrl ? (
      <div class="map-embed">
        <iframe
          src={embedUrl}
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    ) : fallbackLink ? (
      <div class="map-fallback">
        <p class="map-fallback-text">
          Visítanos en nuestro local
        </p>
        <a 
          href={fallbackLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Ver en Google Maps
        </a>
      </div>
    ) : null}
  </div>
</section>

<style>
  .map-section {
    background: #FAF3E8;
  .map-address {
    text-align: center;
    font-size: var(--text-lg);
    color: #5A5046;
    font-weight: 600;
    margin-bottom: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .map-address::before {
    content: "📍";
    font-size: var(--text-xl);
  }

  }

  .map-embed {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    max-width: 100%;
  }

  .map-embed iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
  }

  .map-fallback {
    text-align: center;
    padding: var(--space-12);
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    border: 2px dashed var(--color-border);
  }

  .map-fallback-text {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }
</style>

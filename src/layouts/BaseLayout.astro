---
import '../styles/tokens.css';
import '../styles/global.css';
import siteData from '../content/site.json';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Don Franco - Restaurante Artesanal',
  description = siteData.metaDescription
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": siteData.siteName,
  "description": siteData.metaDescription,
  "url": "https://donfrancorestaurante.com",
  "logo": "https://donfrancorestaurante.com/logo.png",
  "image": "https://donfrancorestaurante.com/logo.png",
  "servesCuisine": ["Hamburguesas", "Cerveza Artesanal", "Parrilla"],
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteData.contact.address,
    "addressLocality": "Salto del Guairá",
    "addressRegion": "Canindeyú",
    "addressCountry": "PY"
  },
  "telephone": siteData.contact.phone,
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ],
    "opens": "17:00",
    "closes": "00:00"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": siteData.reviews.rating.toString(),
    "reviewCount": siteData.reviews.reviewCount.toString()
  },
  "sameAs": [
    siteData.footer.instagramUrl,
    siteData.footer.facebookUrl,
    siteData.footer.mapsUrl
  ].filter(Boolean)
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@400;600;700&display=swap" rel="stylesheet">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>

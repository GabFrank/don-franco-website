// Cloudflare Wrangler configuration for Don Franco admin panel + Pages Functions
{
  "name": "don-franco-website",
  "compatibility_date": "2024-09-10",
  
  // Pages Functions configuration
  // Functions en /functions se despliegan automáticamente con Pages
  
  // D1 Database binding
  // Crear con: wrangler d1 create don-franco-content
  // Aplicar schema: wrangler d1 execute don-franco-content --file=ops/d1/schema.sql
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "don-franco-content",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ],
  
  // R2 Bucket binding para media storage
  // Crear con: wrangler r2 bucket create don-franco-media
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "don-franco-media"
    }
  ],
  
  // Variables de entorno (desarrollo local)
  // En producción configurar via Cloudflare Dashboard > Pages > Settings > Environment Variables
  "vars": {
    "ENVIRONMENT": "development"
    // "ACCESS_AUD": "your-access-audience-tag",
    // "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    // "ADMIN_DEV_BYPASS_SECRET": "dev-secret-for-testing",
    // "CF_PAGES_DEPLOY_HOOK_URL": "https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/..."
  }
}
